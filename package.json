{
  "name": "sogaebank",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:dev": "node --watch-path=src scripts/dev-server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:verify": "node scripts/gen-terms-draft.js && bash scripts/verify-invariants.sh",
    "docs": "node scripts/gen-docs.js && npm run docs:swagger && node scripts/merge-openapi.js && node scripts/gen-api-list.js && node scripts/gen-mvp-plan.js && node scripts/gen-db-doc.js && node scripts/gen-flow-doc.js && node scripts/gen-privacy-policy.js && node scripts/gen-code-doc.js && node scripts/gen-message-doc.js && node scripts/gen-prototype.js && node scripts/gen-terms-draft.js && node scripts/gen-catalog.js",
    "docs:swagger": "ts-node -P tsconfig.scripts.json scripts/dump-swagger.ts",
    "verify": "bash scripts/verify-all.sh && npm run verify:jobs && bash scripts/check-testsafety.sh && npm run check:errcodes && npm run check:acl && npm run check:sql",
    "smoke": "ts-node -P tsconfig.scripts.json scripts/smoke-boot.ts",
    "dev": "node scripts/dev-server.js",
    "db:seed": "psql \"$DATABASE_URL\" -f scripts/fixture.sql",
    "deploy:check": "bash scripts/deploy-check.sh",
    "open:seed": "bash scripts/seed-open.sh",
    "terms:publish": "bash scripts/publish-terms.sh",
    "db:embedded": "node scripts/dev-db.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:seed:dev": "node scripts/seed-dev-passwords.js",
    "attack": "bash scripts/attack-check.sh",
    "test:nts": "ts-node -P tsconfig.scripts.json scripts/test-nts-offline.ts",
    "check:secrets": "bash scripts/check-secrets.sh",
    "test:pay": "ts-node -P tsconfig.scripts.json scripts/test-payment-offline.ts",
    "verify:jobs": "node scripts/verify-jobs.js",
    "scheduler": "node scripts/scheduler-daemon.js",
    "local": "bash scripts/local-setup.sh",
    "guards": "node scripts/check-guards.js",
    "check:testsafety": "bash scripts/check-testsafety.sh",
    "pack": "bash scripts/pack.sh",
    "open:check": "bash scripts/open-check.sh",
    "check:errcodes": "node scripts/check-errcodes.js",
    "check:acl": "node scripts/check-acl.js",
    "seed:roles": "node scripts/seed-test-roles.js",
    "start": "node dist/main.js",
    "matrix": "node scripts/gen-matrix.js",
    "check:sql": "node scripts/check-sql.js",
    "nts:recheck": "ts-node -P tsconfig.scripts.json scripts/nts-recheck.ts",
    "test:consult": "node scripts/test-consult-flow.js"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^16.14.0-beta.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "type": "commonjs",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  }
}
