# =====================================================================
# 운영 서버의 ~/sgb/.env 에 들어가는 값 — 이름과 뜻 (값은 서버에서 만듭니다 · 이 파일을 그대로 쓰지 마십시오)
#
#   · 이미 9/30 에 만든 .env 가 있으면 **그대로 둡니다**. apply.sh 가 새 판으로 가져가고, 없는 것만 아래처럼 보탭니다.
#   · .env 를 고친 뒤에는  pm2 restart sgb sgb-site sgb-jobs  (실행 스크립트가 .env 를 직접 읽습니다)
#   · 권한은 600 (chmod 600 ~/sgb/.env)
# =====================================================================

# ── 꼭 있어야 하는 것 ────────────────────────────────────────────────
# RDS 접속 주소. ★ 지금 서버에서 동작하는 주소가 있으면 바꾸지 마십시오.
#   RDS 는 SSL 을 요구합니다. 앱(Node)과 psql 이 알아듣는 표기가 달라, 아래 둘 중 하나로 적습니다(스크립트가 psql 용으로는 알아서 바꿉니다).
#     …/sgb?sslmode=no-verify                                   암호화는 하되 인증서 대조는 안 함 (가장 간단)
#     …/sgb?sslmode=verify-full&sslrootcert=/home/ubuntu/sgb-data/rds-ca.pem   인증서까지 대조 (RDS 인증서 묶음 파일을 받아 둔 경우)
#   ✗ …?sslmode=require 만 적으면 psql 은 붙지만 **앱은 인증서 대조에 실패**합니다(킷 작업 환경에서 확인).
DATABASE_URL=postgresql://sgbadmin:<암호>@<RDS 엔드포인트>:5432/sgb
# 로그인 토큰 서명 (32자 이상)            openssl rand -base64 48
JWT_SECRET=
# 정산 계좌 · 리드 연락처 암호화 열쇠 ★ 잃어버리면 못 엽니다 — Secrets Manager(start.sh)에서 읽으면 여기는 비워 둡니다
#   (절차서 v2.5 7-3-1)                   openssl rand -base64 32
ENC_KEY=
# 배치 전용 토큰 (32자 이상) — 없으면 배치 호출기(sgb-jobs)를 띄우지 않습니다      openssl rand -hex 24
JOB_TOKEN=
NODE_ENV=production
PORT=3000
DB_POOL_MAX=10

# ── 사용자 웹 (없으면 괄호 안 기본값) ─────────────────────────────────
# SITE_PORT=5174                         (5174)
# API_ORIGIN=http://127.0.0.1:3000       (http://127.0.0.1:<PORT>)
# HOME_CONTENT=live                      (live — 메인이 실제 자료로. 그림의 예시 내용으로 보려면 sample)
# SITE_ORIGIN=https://sogaebank.com   (요청의 주소 — 소개 링크를 만들 때 쓰는 사이트 주소를 고정하려면)
# API_BASE=http://127.0.0.1:3000/api/v1  (http://localhost:3000/api/v1 — 서버 렌더 · 로그인이 직접 부르는 API · v10.31)
# BO_URL=https://admin.sogaebank.com  (http://localhost:5173 — 머리줄 「관리자 페이지」 · v10.31)
# ADMIN_ORIGIN=https://admin.sogaebank.com (없으면 중개사 인증 「검수자 화면 보기」 단추 숨김 · v10.31)
# 운영 화면(web) 빌드 때: VITE_SITE_URL=https://sogaebank.com (없으면 admin. 을 뗀 주소)

# ── 올린 파일 — 둘 중 하나 ★ 열기 전에 정하십시오(중간에 바꾸면 전에 올린 파일을 열 수 없습니다) ──
# ① 서버 디스크 — apply.sh 가 없으면 넣어 줍니다. RDS 스냅샷에 들어가지 않으니 따로 백업
# UPLOAD_DIR=/home/ubuntu/sgb-data/uploads
# ② S3 — 버킷 하나(비공개). EC2 역할에 그 버킷의 PutObject · GetObject · DeleteObject, 버킷 CORS 에 사이트 · 운영 화면 주소의 PUT · GET
#   ★ 이름은 S3_BUCKET 입니다. 절차서 v2.5 10-5 의 S3_UPLOAD_BUCKET · S3_PUBLIC_BUCKET · CDN_BASE_URL 은 지금 코드가 읽지 않습니다.
# S3_BUCKET=sgb-uploads
# AWS_REGION=ap-northeast-2

# ── 외부 연동 키 — 계약 뒤에. 없으면 그 기능은 간주 모드(assume.*) 또는 「준비 중」으로 돕니다 ──
#   ★ v10.128(docs/192) — 아래 키는 모두 **운영 화면 › 통합 현황 › 외부 연동 › 「연동 키」(SUPER)에서 넣는 것이 먼저**입니다
#     (암호화 저장 · 1분 안에 반영 · 다시 띄우거나 빌드할 필요 없음 · 결제창 클라이언트 키도). 여기 값은 운영 화면 키가 없을 때만 씁니다.
#     주소 · 제한 시간(…_URL · …_BASE · SMTP_HOST · SMTP_USER 등)은 키가 아니라 여기에 둡니다.
# TOSS_SECRET_KEY=            NEXT_PUBLIC_TOSS_CLIENT_KEY=      (전자결제)
# NTS_SERVICE_KEY=                                              (국세청 사업자 확인)
# PASS_API_KEY=                                                 (본인인증)
# ESIGN_API_KEY=                                                (전자서명)
# ALIMTALK_KEY=                                                 (알림톡 대행사 — v10.44 · 키가 있고 운영 화면에서 ALIMTALK 을 LIVE 로 바꿔야 상담 인증번호를 휴대폰으로도 보냄 · docs/93)
# SAFENUM_KEY=                                                  (050 안심번호 — 업체 미정)
# ETAX_URL=  ETAX_KEY=                                          (전자세금계산서 업체(ASP) — v10.34 · 업체를 정한 뒤. 둘 다 있고 운영 화면에서 assume.etax 를 꺼야 국세청으로 보냅니다
#                                                                 · 그 전에는 홈택스에서 발행하고 운영 화면 「홈택스 발행 번호 넣기」 · docs/전자세금계산서_연동절차.md)
# BANK_VERIFY_URL=  BANK_VERIFY_KEY=                            (1원 계좌인증 — 경로 · 인증 머리 칸은 src/modules/billing/bank-verify.provider.ts 머리말)
# BROKER_LOOKUP_URL=  BROKER_LOOKUP_KEY=                        (국토부 중개사 자격 대조 — 응답 경로 칸은 src/modules/partner/broker-lookup.provider.ts 머리말)
# KAKAO_REST_KEY=            NEXT_PUBLIC_KAKAO_JS_KEY=         (카카오맵 — v10.46 · docs/96. **운영 화면 › 외부 연동 › 카카오맵 키에서 넣는 것이 먼저**(암호화 저장 · 빌드 불필요)
#                                                                 · 여기 값은 운영 화면 값이 없을 때만 씀. 지도 사용(map.enabled)은 처음 off)
# KAKAO_LOCAL_BASE=  KAKAO_LOCAL_TIMEOUT_MS=                    (카카오 로컬 주소 · 제한 시간 — 바꿀 때만. 비우면 https://dapi.kakao.com · 3000)
# KMA_SERVICE_KEY=                                              (기상청 단기예보 · 메인 「오늘의 날씨」 — v10.49 · docs/101. **운영 화면 › 외부 연동 › 날씨 키에서 넣는 것이 먼저**(암호화 저장)
#                                                                 · 여기 값은 운영 화면 값이 없을 때만 씀. 날씨 사용(weather.enabled)은 처음 off)
# KMA_API_BASE=  KMA_TIMEOUT_MS=                                (기상청 주소 · 제한 시간 — 바꿀 때만. 비우면 https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0 · 3000)
# ANTHROPIC_API_KEY=         AGENT_PROVIDER=CLAUDE             (AI · Anthropic — v10.104 · v10.111 docs/173. **운영 화면 › AI 운영 › AI 에이전트 › 「AI 키」에서 넣는 것이 먼저**(암호화 저장)
#                                                                 · 여기 값은 운영 화면 키가 없을 때만 씀(그때는 AGENT_PROVIDER=CLAUDE 도 필요). **운영에 AGENT_PROVIDER=MOCK 금지**(시험 엔진)
#                                                                 · 키가 있어도 AI 전체(agent.enabled) · 월 상한(agent.monthly_cap_usd 0)이 꺼져 있으면 부르지 않음)
# ── 메일(Amazon SES SMTP) — v10.43 · docs/92. SMTP_HOST · USER · PASS 와 보내는 주소가 있고 운영 설정 notify.email_verified = on 이어야 보냅니다 ──
#   알림톡 연동 전에는 상담 신청 인증번호를 이 메일로 보냅니다(없으면 운영에서 상담 신청이 닫힘 · NOTIFY_NOT_READY)
# SMTP_HOST=email-smtp.ap-northeast-2.amazonaws.com
# SMTP_PORT=465
# SMTP_USER=                  SMTP_PASS=                        (SES 콘솔 「SMTP 자격 증명」 — IAM 액세스 키 아님)
# MAIL_FROM=no-reply@mail.sogaebank.com   (운영 설정 notify.mail_from 이 비었을 때만 씀 — 운영 화면에서 notify.mail_from 을 채우는 것을 권함)
# MAIL_FROM_NAME=소개뱅크
# NTS_API_BASE=  TOSS_API_BASE=                                 (주소를 바꿀 때만 — 비우면 각 업체 기본 주소)
