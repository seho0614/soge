# 소개뱅크 개발 Docker — 환경 값
# 복사해서 씁니다:   copy .env.example .env   (Windows)   /   cp .env.example .env
#
# ★ 이 값들은 **개발용**입니다. 운영 서버의 .env 와 절대 섞지 마십시오.
#   운영 JWT_SECRET · ENC_KEY 는 AWS 절차서 7-3 대로 서버에서 새로 만듭니다.

# ── DB ───────────────────────────────────────────────────────────
PG_USER=sgb
PG_PASSWORD=sgb
PG_PORT=5432

# ── 앱 비밀값 (개발용 고정값 · 32자 이상) ───────────────────────────
JWT_SECRET=docker-dev-jwt-secret-0123456789abcdef
# 정산 계좌 · 리드 연락처 암호화 열쇠. 바꾸면 이미 암호화된 개발 데이터를 못 풉니다
ENC_KEY=docker-dev-enc-key-0123456789abcdef
# 배치(스케줄러) 전용 토큰. 32자 미만이면 서버가 항상 거부합니다
JOB_TOKEN=docker-dev-job-token-0123456789abcdef

# 개발 계정 비밀번호 (admin@x.com · intro@x.com · buyer@x.com · person@x.com · seller@x.com)
DEV_PASSWORD=sgb-dev-1234

# 약관 시행일 — 처음 준비할 때 발행합니다. 과거 날짜는 받지 않습니다
EFFECTIVE_FROM=2026-10-01

# ── 포트 (겹치면 바꾸십시오) ────────────────────────────────────────
API_PORT=3000
WEB_PORT=5173
SITE_PORT=5174

# ── 운영 화면 ↔ 사용자 웹 주소 (v10.31) ────────────────────────────────
# 포트를 바꾸거나 다른 주소로 열 때만 고칩니다(비우면 아래 기본값).
#   SITE_URL     — 운영 화면(BO)의 「사용자 화면으로」 · 바닥줄 링크가 가는 사용자 웹 주소 (web 의 VITE_SITE_URL)
#   BO_URL       — 사용자 웹 머리줄 「관리자 페이지」(운영 역할만 보임)가 가는 운영 화면 주소
#   ADMIN_ORIGIN — 사용자 웹 중개사 인증 화면의 「검수자 화면 보기」 단추가 여는 운영 화면 주소(비우면 단추를 숨김)
# 사용자 웹 서버 쪽 API 주소(API_BASE)는 docker-compose.yml 에 고정(http://api:3000/api/v1)입니다 — 따로 띄울 때는 sgb/.env.example 참고.
SITE_URL=http://localhost:5174
BO_URL=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5173

# ── 메인(/) 내용 (v10.13) ───────────────────────────────────────────
# 비워 두면 디자인 그림의 내용 그대로 나옵니다(순위 · 평점 · 참여 수 · 인물은 예시 — 메인 맨 아래에 그렇게 적혀 있습니다).
# live 로 바꾸고 `docker compose up -d site` 하면 같은 모양에 실제 매물 · 상품 · 요청 · 소개광장 글이 들어갑니다.
# ★ 실제 손님에게 열기 전에는 live 로 바꾸십시오 — 예시 평점 · 후기 수가 실제처럼 보이면 안 됩니다.
HOME_CONTENT=

# ── 결제사(토스) 테스트 열쇠 (v10.18 · 선택) ──────────────────────────────
# 비워 두면 열쇠 없는 방식(스텁)입니다 — 모든 결제가 「승인된 것으로」 처리되고 실제 결제는 없습니다(평소 개발은 이대로).
# 결제 · 환불을 결제사 테스트 환경에서 확인할 때만 test_sk_… 를 넣고 `docker compose up -d api` (절차: sgb/docs/62_… 9절).
# ★ 운영(라이브) 열쇠를 여기에 넣지 마십시오.
TOSS_SECRET_KEY=
# 결제사 주소를 바꿀 때만(기본 https://api.tosspayments.com) — 응답을 일부러 끊는 중계 서버로 장애를 볼 때 씁니다
TOSS_API_BASE=

# ── 카카오맵 (v10.46 · 선택 · docs/96) ───────────────────────────────────
# 보통은 비워 둡니다 — 운영 화면(5173) › 외부 연동 › 카카오맵 키에 넣으면 DB 에 암호화해 저장되고 그 값이 먼저입니다.
# 여기 값은 운영 화면 값이 없을 때만 씁니다. 키가 있어도 운영 화면에서 「지도 사용」을 켜야 지도가 나옵니다(처음 off).
# 카카오 콘솔 › 플랫폼 › Web 사이트 도메인에 http://localhost:5174 · http://localhost:5173 을 넣어야 지도가 뜹니다.
KAKAO_REST_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 오늘의 날씨 — 기상청 단기예보 (v10.49 · 선택 · docs/101) ──────────────────
# 보통은 비워 둡니다 — 운영 화면(5173) › 외부 연동 › 날씨 키에 넣으면 DB 에 암호화해 저장되고 그 값이 먼저입니다.
# 키가 있어도 운영 화면에서 「날씨 사용」을 켜야 메인에 날씨 띠가 나옵니다(처음 off).
KMA_SERVICE_KEY=

# 1 로 두고 up 하면 개발 데이터를 지우고 처음처럼 다시 준비합니다 (평소 0)
SGB_RESET=0
