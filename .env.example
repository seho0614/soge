# 소개뱅크 API — 로컬 개발용 환경 변수
# 복사: cp .env.example .env   (dev-server 와 scripts/*.js 가 .env 를 자동으로 읽습니다)

# 필수 ────────────────────────────────────────────────
DATABASE_URL=postgresql://sgb:sgb@localhost:5432/sgb
# 운영은 32자 이상. 개발용 값은 그대로 써도 됩니다
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# ★ 20260930 — 정산 계좌 · 리드 연락처 암호화 열쇠 (32자 이상).
#   없으면 계좌 저장이 "ENC_KEY: 암호화 열쇠가 없습니다" 로 실패하고 리드 연락처가 열리지 않습니다.
ENC_KEY=dev-only-enc-key-change-me-0123456789abcdef

# 선택 ────────────────────────────────────────────────
PORT=3000
DB_POOL_MAX=10
NODE_ENV=development

# 임베디드 PostgreSQL 포트. Docker 를 쓰면 무시됩니다
DEV_DB_PORT=54329

# 개발 계정 비밀번호. scripts/seed-dev-passwords.js 가 씁니다
# fixture.sql 은 password_hash 를 'h' 로 두므로, 이 스크립트를 돌리지 않으면
# 로그인이 되지 않습니다
DEV_PASSWORD=sgb-dev-1234

# 외부 연동 키 — 없으면 어댑터가 스텁으로 동작하고 응답에 stub:true 가 실립니다
# NTS_SERVICE_KEY=
# KAKAO_REST_KEY=            (v10.46 카카오맵 — 운영 화면 › 외부 연동 › 카카오맵 키가 먼저 · docs/96)
# NEXT_PUBLIC_KAKAO_JS_KEY=
# PASS_API_KEY=

# 토스페이먼츠
#   시크릿 키는 서버에만 둡니다. Basic 인증 헤더로만 나갑니다.
#   클라이언트 키는 결제창용이라 브라우저에 노출돼도 됩니다 —
#   그래서 site/ 의 NEXT_PUBLIC_ 접두사 변수로 따로 둡니다.
# TOSS_SECRET_KEY=
# NEXT_PUBLIC_TOSS_CLIENT_KEY=

# EventBridge 가 정기 작업을 부를 때 쓰는 전용 토큰.
#
# 사람 계정의 JWT 를 스케줄러에 심지 마십시오 —
# 만료되면 배치가 조용히 멈추고, 새면 관리자 전 권한이 넘어갑니다.
# 이 토큰으로는 job 실행만 되고 다른 관리자 API 는 열리지 않습니다.
#
# 32자 미만이면 **항상 거부**합니다. 설정을 빠뜨린 채 배포하면
# 배치가 안 도는 편이 아무나 부를 수 있는 것보다 낫습니다.
#   openssl rand -hex 24
JOB_TOKEN=

# ── 파일 올리기 (D007) ────────────────────────────────────────────
# S3_BUCKET 이 있으면 S3(presigned PUT/GET — 브라우저가 S3 로 직접), 없으면 로컬 저장소(개발).
# 자격 증명은 AWS 표준 순서: AWS_ACCESS_KEY_ID/SECRET(/SESSION_TOKEN) → ECS 태스크 역할 → EC2 인스턴스 역할(IMDSv2).
# 버킷 CORS 에 사이트 · BO 출처의 PUT(Content-Type) · GET 을 열어 두십시오.
S3_BUCKET=
AWS_REGION=ap-northeast-2
# S3 호환 저장소 · 시험용 가짜 서버만. 비우면 AWS 표준 주소
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
# 로컬 저장소 위치 (S3_BUCKET 이 없을 때). 저장소 루트 밖으로는 쓰지 않습니다
UPLOAD_DIR=./uploads
# 로컬 토큰 주소 서명 키. 비우면 JWT_SECRET 에서 파생
FILE_TOKEN_SECRET=

# ── 사용자 웹(site) · 운영 화면(web) 주소 (v10.31) ─────────────────────────
# 사용자 웹(Next.js)을 따로 띄울 때 site/ 쪽 환경 값입니다(docker-compose 는 자동으로 넣습니다).
#   API_ORIGIN   — 브라우저가 부르는 /api 를 넘길 곳(next.config.js rewrites)
#   API_BASE     — 서버 렌더 · 미들웨어 · 로그인이 직접 부르는 API(★ 없으면 http://localhost:3000/api/v1 — 다른 포트의 API 를 쓰면 꼭 넣으십시오)
#   BO_URL       — 머리줄 「관리자 페이지」(/go/admin)가 갈 운영 화면 주소(없으면 http://localhost:5173)
#   ADMIN_ORIGIN — 중개사 인증 「검수자 화면 보기」가 여는 운영 화면 주소(없으면 단추 숨김)
# API_ORIGIN=http://localhost:3000
# API_BASE=http://localhost:3000/api/v1
# BO_URL=http://localhost:5173
# ADMIN_ORIGIN=http://localhost:5173
# 운영 화면(web · Vite) 쪽:
#   VITE_SITE_URL — 「사용자 화면으로」 · 바닥줄 링크의 사용자 웹 주소(없으면 5173 → 5174 로 짐작 · 운영은 admin. 을 뗀 주소)
# VITE_SITE_URL=http://localhost:5174
